# Copy to .env for local wrangler dev (secrets are set via `wrangler secret put`)

# AI transcript analysis keys
OPENROUTER_API_KEY=""
HF_TOKEN=""

# Cloudflare Workers AI text analysis (REST API)
# Nova-3 speech-to-text uses the AI binding and does not need these secrets.
CF_ACCOUNT_ID=""
CF_API_TOKEN=""

# Generic OpenAI-compatible LLM API (optional)
LLMAPI_URL=""
LLMAPI_KEY=""

# Speech-to-text providers (Deepgram Nova-3 uses the Cloudflare AI binding)
ELEVENLABS_API_KEY=""

# Policy Observatory document API (optional)
POLICY_OBSERVATORY_API_KEY=""
